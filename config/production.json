{
  "@opentermsarchive/engine": {
    "recorder": {
      "versions": {
        "storage": {
          "git": {
            "snapshotIdentiferTemplate": "https://github.com/Boipisigre/Suisse-snapshots/commit/%SNAPSHOT_ID",
            "repository": "git@github.com:Boipisigre/Suisse-versions.git",
            "path": "./data/versions"
          }
        }
      },
      "snapshots": {
        "storage": {
          "git": {
            "repository": "git@github.com:Boipisigre/Suisse-snapshots.git",
            "path": "./data/snapshots"
          }
        }
      }
    },
    "fetcher": {
      "language": "en"
    },
    "notifier": {
      "sendInBlue": {
        "updatesListId": 0,
        "updateTemplateId": 0
      }
    },
    "reporter": {
      "type": "github",
      "repositories": {
        "declarations": "Boipisigre/Suisse-declarations",
        "versions": "Boipisigre/Suisse-versions",
        "snapshots": "Boipisigre/Suisse-snapshots"
      }
    },
    "dataset": {
      "title": "Suisse",
      "versionsRepositoryURL": "https://github.com/Boipisigre/Suisse-versions"
    },
    "collection-api": {
      "port": 3000,
      "basePath": "/collection-api"
    },
    "logger": {
      "smtp": {
         "host": "mail.infomaniak.com",
         "username": "pib@pirboazo.net"
	}
    }
  }
}
